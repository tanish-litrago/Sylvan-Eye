# Copy this file to .env IN THIS FOLDER (docker/.env, git-ignored) and edit. Never commit .env.
# Then run docker compose from this folder.

# Folder where `earthengine authenticate` saved your login. It is mounted READ-ONLY.
# Windows: use forward slashes, e.g. C:/Users/YOURNAME/.config/earthengine
SYLVAN_EE_DIR=C:/Users/YOURNAME/.config/earthengine

# Postgres password: LETTERS AND DIGITS ONLY (it is placed inside a URL). Choose your own, leave no spaces.
# It is applied when the database is first created; changing it later needs the volume removed.
POSTGRES_PASSWORD=

# Optional: where the container finds Ollama (this is the default).
# SYLVAN_OLLAMA_URL=http://host.docker.internal:11434/api/chat
